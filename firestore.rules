rules_version = '2';
// Paste this into Firebase → Firestore Database → Rules and press Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // Saved challenges: each user reads and writes only their own document.
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Public profiles: any signed-in user can read them (to follow people);
    // only the owner writes, and only these fields.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid)
        && request.resource.data.keys().hasOnly(['handle', 'name', 'shared', 'challenges', 'pro', 'updated', 'badges', 'wins'])
        && (!('badges' in request.resource.data) || (request.resource.data.badges is list && request.resource.data.badges.size() <= 30))
        && (!('wins' in request.resource.data) || (request.resource.data.wins is list && request.resource.data.wins.size() <= 60))
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.challenges is list && request.resource.data.challenges.size() <= 30;
      allow delete: if isUser(uid);
    }

    // Usernames: one owner each, first come first served.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Who you follow: private.
    match /follows/{uid} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid) && request.resource.data.uids is list && request.resource.data.uids.size() <= 50;
    }

    // 🏆 Leaderboard: everyone signed in can read it; you write only your own row.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['handle', 'name', 'country', 'pro', 'points', 'proofs', 'challenges', 'updated'])
        && request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 1000000
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$');
    }

    // 🏆 Challenge of the week: everyone signed in reads the standings; you write only your own row.
    match /weekly/{week}/entries/{uid} {
      allow read: if signedIn();
      allow delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['handle', 'pro', 'points', 'proofs', 'done', 'total', 'updated'])
        && request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 100000
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$');
    }

    // ⚔️ Head-to-head: only its two players can see or change it, and the players never change.
    match /duels/{id} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn() && request.resource.data.players is list && request.resource.data.players.size() == 2
        && request.resource.data.players[0] == request.auth.uid && request.resource.data.a.uid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.link is string && request.resource.data.link.size() < 20000;
      allow update: if signedIn() && request.auth.uid in resource.data.players
        && request.resource.data.players == resource.data.players && request.resource.data.link == resource.data.link;
    }

    // 📸 Proof photos: anyone signed in can look; you add and remove your own (each under ~700 KB).
    match /proofs/{uid}/items/{id} {
      allow read: if signedIn();
      allow delete: if isUser(uid);
      allow create, update: if isUser(uid) && request.resource.data.image is string && request.resource.data.image.size() < 750000;
    }

    // 💬 Community. Posting needs a username, and the post carries that same username.
    function myHandle() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle; }
    function canPost() { return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
      && request.resource.data.uid == request.auth.uid && request.resource.data.handle == myHandle(); }
    // Others may only bump a count by one (replies on a thread, votes on a pick).
    function bumps(fields, counter) { return signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields)
      && (request.resource.data[counter] - resource.data[counter] == 1 || request.resource.data[counter] - resource.data[counter] == -1); }

    match /forum/{id} {
      allow read: if signedIn();
      allow create: if canPost() && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000 && request.resource.data.replies == 0;
      allow update: if (isUser(resource.data.uid) && request.resource.data.uid == resource.data.uid) || bumps(['replies', 'lastAt'], 'replies');
      allow delete: if isUser(resource.data.uid);
      match /replies/{rid} {
        allow read: if signedIn();
        allow create: if canPost() && request.resource.data.body is string && request.resource.data.body.size() <= 1000;
        allow delete: if isUser(resource.data.uid);
      }
    }
    match /picks/{id} {
      allow read: if signedIn();
      allow create: if canPost() && request.resource.data.note is string && request.resource.data.note.size() <= 300 && request.resource.data.votes == 0;
      allow update: if bumps(['votes'], 'votes');
      allow delete: if isUser(resource.data.uid);
      match /votes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isUser(uid);
      }
    }
    // Reports: anyone signed in can file one; only you (in the Firebase console) read them.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // ⭐ Pro: the "Run Payments with Stripe" extension's collections.
    match /customers/{uid} {
      allow read: if isUser(uid);
      match /checkout_sessions/{id} {
        allow read, write: if isUser(uid);
      }
      match /subscriptions/{id} {
        allow read: if isUser(uid);
      }
      match /payments/{id} {
        allow read: if isUser(uid);
      }
    }
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }
  }
}
